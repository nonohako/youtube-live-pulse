<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LivePulse</AssemblyName>
    <ApplicationIcon>../../assets/pulse.ico</ApplicationIcon>
    <!-- Tray app: prefer a small heap over GC throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="../LivePulse.NativeStore/LivePulse.NativeStore.csproj" />
    <Content Include="../../src/renderer/**" Link="src/renderer/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/**" Link="assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="bridge.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixture-state.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
